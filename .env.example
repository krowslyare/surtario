# Backend local de desarrollo. No contiene claves ni credenciales.
# Copiar esta URL a .env.local si la CLI no la añade. Reiniciar Vite al cambiarla.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Firecrawl se configura en el backend, NO aquí ni con prefijo VITE_.
# Sin escribir la clave en el comando: npx convex env set FIRECRAWL_API_KEY --deployment local
# Ver docs/desarrollo/INTEGRACIONES.md. OpenAI tiene prueba interna; AgentMail sigue pendiente.

# OpenAI: OPENAI_API_KEY y OPENAI_EXTRACTION_MODEL se configuran en Convex local, nunca como VITE_*.
# Ver docs/desarrollo/EXTRACCION_REVISION.md. No incluir valores reales en este archivo.

# Descubrimiento público acotado. Debe ser exactamente true y las claves se configuran
# solo en Convex. Sin estas variables, status informa la capacidad como deshabilitada.
# LIVE_RESEARCH_ENABLED=true
# FIRECRAWL_API_KEY (secreto en Convex)
