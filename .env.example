# Public frontend configuration only. Use the local URL provided by the Convex CLI.
# Restart Vite after changing .env.local. No provider keys belong in this file.
VITE_CONVEX_URL=http://127.0.0.1:3210

# Configure the following names in the Convex BACKEND environment only.
# All provider gates remain disabled when absent; enable one capability at a time.
# See docs/desarrollo/CREDENTIALS_AND_E2E.md for the verification sequence.

# Web research and reviewed extraction:
# LIVE_RESEARCH_ENABLED=true
# FIRECRAWL_API_KEY (server secret)
# OPENAI_API_KEY (server secret)
# OPENAI_EXTRACTION_MODEL (verified model selection)
# SEARCH_AUTO_REVIEW_ENABLED=true (optional: up to 3 AI source reviews per new search)

# Persistent research self-loop and explicit selected-source monitoring:
# SOURCING_ENABLED=true
# SOURCE_WATCH_ENABLED=true
# Require the web research gate and credentials above.
# At most 3 steps/run and 3 runs/case; watches: 24 hours, seven days, 3 sources/case.

# Optional editable AI supplier inquiry (never sends by itself):
# QUOTATION_DRAFT_ENABLED=true
# Uses OPENAI_API_KEY and OPENAI_EXTRACTION_MODEL.

# Bundled synthetic image/PDF extraction:
# DOCUMENT_EXTRACTION_ENABLED=true
# Uses OPENAI_API_KEY and a compatible OPENAI_EXTRACTION_MODEL.

# AI suggestions from linked quotation replies:
# REPLY_EXTRACTION_ENABLED=true
# Uses OPENAI_API_KEY and a compatible OPENAI_EXTRACTION_MODEL.

# Purchasing advisor:
# ADVISOR_ENABLED=true
# OPENAI_ADVISOR_MODEL (verified model selection; uses OPENAI_API_KEY)

# Reviewed test email:
# AGENTMAIL_ENABLED=true
# AGENTMAIL_API_KEY (server secret)
# AGENTMAIL_INBOX_ID (frozen test inbox)
# AGENTMAIL_TEST_RECIPIENT (one author-approved test recipient)
# AGENTMAIL_WEBHOOK_SECRET (server signing secret for /agentmail/webhook)

# Static hosting is prepared. npm run check:hosting is local; deploy:hosting publishes.
# See docs/desarrollo/HOSTING.md. Deployment credentials must never be committed.
